# Copy to .env and replace the values (generate secrets with: openssl rand -hex 32)
JWT_SECRET=change-me
TURN_SECRET=change-me
# LAN IP clients use to reach this machine (see `hostname -I`).
# Not 127.0.0.1: coturn refuses to relay to loopback addresses.
PUBLIC_IP=192.168.1.10
# LAN demo only: allow coturn to relay to this one private address
# (usually the same as PUBLIC_IP). Leave unset on a public server.
# TURN_ALLOWED_PEER_IP=192.168.1.10
